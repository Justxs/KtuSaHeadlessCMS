# Copy to .env.production and fill in. That file is git-ignored.
# See docs/DEPLOYMENT.md section 2 for the full reference.
#
# Note the double underscore before the property name. The section name itself
# contains single underscores; only the level separator is doubled.

# ---- Google Cloud media storage (required) ----
OrchardCore_Media_GoogleCloudStorage__BucketName=
OrchardCore_Media_GoogleCloudStorage__RequireGoogleCloudStorage=true

# Option A: mount the service-account key and let the SDK find it.
OrchardCore_Media_GoogleCloudStorage__UseApplicationDefaultCredentials=true
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-service-account.json

# Option B: inline credentials instead. Set UseApplicationDefaultCredentials to
# false and supply either CredentialsJson or the individual fields. PrivateKey
# takes literal \n sequences, not real newlines.
# OrchardCore_Media_GoogleCloudStorage__UseApplicationDefaultCredentials=false
# OrchardCore_Media_GoogleCloudStorage__CredentialsJson=
# OrchardCore_Media_GoogleCloudStorage__ProjectId=
# OrchardCore_Media_GoogleCloudStorage__ClientEmail=
# OrchardCore_Media_GoogleCloudStorage__PrivateKeyId=
# OrchardCore_Media_GoogleCloudStorage__PrivateKey=

# Optional: media served from a CDN or custom domain rather than
# storage.googleapis.com. Must also be allowed by the website's CSP.
# OrchardCore_Media_GoogleCloudStorage__PublicBaseUrl=
# OrchardCore_Media_GoogleCloudStorage__BasePath=

# ---- Fienta event import (optional) ----
# Without an organiser ID the event editor's Fienta dropdown stays empty.
Fienta__OrganiserId=
# Fienta__BaseUrl=https://fienta.com/api/v1/public/events
